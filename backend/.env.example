# Required
# DATABASE_URL=sqlite:///./phishing_detector.db
# For Render / Postgres: DATABASE_URL=postgresql://user:pass@host/db
PORT=10000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.vercel.app,https://*.onrender.com,https://*.netlify.app

# Optional Threat Intel API keys (without them, app uses heuristic fallback)
# VIRUSTOTAL_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Optional Redis cache for geolocation/whois (falls back to in-memory)
# REDIS_URL=redis://localhost:6379/0

MAX_FILE_SIZE=10485760
