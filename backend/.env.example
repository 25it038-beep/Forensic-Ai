# App / Runtime
ENV=production
NODE_ENV=production
SECRET_KEY=change-me-to-32-plus-char-random
ACCESS_TOKEN_EXPIRE_HOURS=24

# CORS — comma separated origins
CORS_ORIGINS=https://your-frontend.vercel.app,https://your-frontend.netlify.app

# File limits
MAX_FILE_SIZE=10485760

# Database
DATABASE_URL=sqlite:///./phishing_detector.db
# For Postgres: postgresql://user:pass@host:5432/dbname

# ML model paths
MODEL_PATH=backend/models/model.pkl
VECTORIZER_PATH=backend/models/vectorizer.pkl

# LLM / Chat providers
GEMINI_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=
NVAPI_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# External intel / APIs
IPINFO_API_KEY=
VIRUSTOTAL_API_KEY=
REDIS_URL=

# Temp / OS
TEMP=/tmp
