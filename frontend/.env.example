# Production API URL - required when frontend and backend are on different hosts
# For local dev with Vite proxy, leave empty or unset to use same-origin /api via proxy
# For production (Vercel, Netlify):
# Vercel: set VITE_API_URL to your Render/backend URL, e.g. https://emailsupcious.onrender.com
# Netlify: same
VITE_API_URL=https://forensic-ai-2.onrender.com

# Extension store link for Try Extension button (BrowserExtensionInfo)
# Example: https://chrome.google.com/webstore/detail/your-extension-id or https://your-site.com/extension
# VITE_EXTENSION_URL=https://chrome.google.com/webstore/detail/forensic-ai

# Optional proxy target for local dev (only used by Vite dev server)
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
